PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/eventpilot
# Optional comma-separated DNS resolvers for mongodb+srv connections (default: 1.1.1.1,1.0.0.1)
MONGODB_DNS_SERVERS=1.1.1.1,1.0.0.1
FRONTEND_URL=http://localhost:5173
# Optional public frontend URL used to construct email links (defaults to FRONTEND_URL)
APP_URL=http://localhost:5173
# SMTP delivery settings for verification and password recovery email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Required to enable organizer MFA. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=
# Required. Use a long random string, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Used only by `npm run seed:organizers` (min 8 chars)
SEED_ORGANIZER_PASSWORD=
# Used only by `npm run seed:events` outside production (min 12 chars)
SEED_DEMO_PASSWORD=
